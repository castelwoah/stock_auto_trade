# 템플릿 — @PROJECT_ROOT@ / @RUN_USER@ / @RUN_GROUP@ / @PYTHON@ 는
# scripts/install-systemd.sh 가 설치 시점에 실제 값으로 치환한다.
[Unit]
Description=KIS Auto-Trading Daemon (mini-trading)
Documentation=file://@PROJECT_ROOT@/docs/scheduling.md
Documentation=file://@PROJECT_ROOT@/docs/runbook.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@RUN_USER@
Group=@RUN_GROUP@
WorkingDirectory=@PROJECT_ROOT@

# PATH 는 프로젝트 venv 우선 (scripts/setup-dev.sh 로 생성한 .venv)
Environment="PATH=@PROJECT_ROOT@/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="TZ=Asia/Seoul"

# 설정 우선순위 (D10): ENV > .env > config.yaml. 필요 시 ENV 로 오버라이드.
# Environment="KIS_ENV=PAPER"

ExecStart=@PYTHON@ -m src.main

# 크래시 시 자동 복구 (Phase 4 실자본 단계의 핵심)
Restart=on-failure
RestartSec=30

# graceful shutdown — main.py 의 SIGINT/SIGTERM 핸들러가 받음
KillSignal=SIGTERM
TimeoutStopSec=60

# 로그 — journald 로 통합 (journalctl -u mini-trading) + 파일에도 append
StandardOutput=append:@PROJECT_ROOT@/logs/main.log
StandardError=append:@PROJECT_ROOT@/logs/main.err
SyslogIdentifier=mini-trading

# 보안 강화 (rules §11.1 권장)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=@PROJECT_ROOT@

[Install]
WantedBy=multi-user.target
